{
  "version": 2,
  "public": true,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "frontend/**/*", "use": "@vercel/static" },
    { "src": "data/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/frontend/index.html" },
    { "src": "/frontend/(.*)", "dest": "/frontend/$1" },
    { "src": "/data/(.*)", "dest": "/data/$1" }
  ]
}
