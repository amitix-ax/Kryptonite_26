# Copy this file to .env (which is gitignored) and fill in your own
# credentials. Every service below is free to register for. See
# src/iceberg_model/data/fetchers/credentials.py for exactly how each
# variable is used, and docs/data_pipeline.md for setup links.

# Copernicus Climate Data Store (ERA5 wind) -- https://cds.climate.copernicus.eu/
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# NASA Earthdata (AMSR2 sea ice via NSIDC, BedMachine Antarctica via NSIDC)
# -- https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Alternatively, a token instead of username/password:
# EARTHDATA_TOKEN=

# Copernicus Marine Service (ocean currents) -- https://data.marine.copernicus.eu/register
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
